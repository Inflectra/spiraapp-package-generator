SPIRA_BASE_URL=https://your-spira-instance.example.com
SPIRA_USERNAME=your_username
SPIRA_PASSWORD=your_password
# Optional: comma-separated project IDs to enable the SpiraApp for (e.g. 1,2,3)
SPIRA_ENABLE_PROJECT_IDS=
# Optional: comma-separated project IDs to disable the SpiraApp for (e.g. 1,2,3)
SPIRA_DISABLE_PROJECT_IDS=
# Optional: set to true to run the browser in headless mode; default is headed (non-headless)
PLAYWRIGHT_HEADLESS=
# Optional: set to true to enable Developer Mode in Spira General Settings before uploading; default is skipped
SPIRA_ENABLE_DEV_MODE=
# Optional: set to true to auto-increment the patch version in manifest.yaml before each build; default is to skip the version bump
SPIRA_INCREMENT_VERSION=
