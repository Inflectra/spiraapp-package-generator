SPIRA_BASE_URL=https://your-spira-instance.example.com
SPIRA_USERNAME=your_username
SPIRA_PASSWORD=your_password
# Optional: comma-separated project IDs to enable the SpiraApp for (e.g. 1,2,3)
SPIRA_ENABLE_PROJECT_IDS= 1, 2
# Optional: comma-separated project IDs to disable the SpiraApp for (e.g. 1,2,3)
SPIRA_DISABLE_PROJECT_IDS= 3, 4
# Optional: set to false to run the browser in headed mode (visible window); default is true (headless)
PLAYWRIGHT_HEADLESS=true
# Optional: set to true to enable Developer Mode in Spira General Settings before uploading; default is false (skipped)
SPIRA_ENABLE_DEV_MODE=false
# Optional: set to true to auto-increment the patch version in manifest.yaml before each build; default is false (skipped)
SPIRA_INCREMENT_VERSION=false
